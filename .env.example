# Local PostgreSQL Compose values only. Replace the placeholder password before
# starting the development database. This file contains no usable credentials.
POSTGRES_DB=formi_dev
POSTGRES_USER=formi_dev
POSTGRES_PASSWORD=replace-with-a-local-only-password

# Example URLs for the CLI process (the application does not load .env itself).
# Set the values in the current shell after replacing the password above.
CONTROLLER_DATABASE_URL=postgresql+asyncpg://formi_dev:replace-with-a-local-only-password@127.0.0.1:5433/formi_dev
CONTROLLER_TEST_DATABASE_URL=postgresql+asyncpg://formi_dev:replace-with-a-local-only-password@127.0.0.1:5433/formi_test
